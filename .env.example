# Express server port (default 3000)
PORT=3000

# Google Gemini API Key - Retrieve from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_api_key_here

# Simulated Mock Mode for Testing (NONE, VALID, MALFORMED_JSON, INVALID_SCHEMA, EMPTY_RESPONSE, API_ERROR, SLOW_RESPONSE)
# Leave as NONE or undefined to use the real API
MOCK_MODE=NONE
